DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_USE_SQLITE=False

# MySQL（启用时把 settings.py 中 DATABASES 切换为环境变量配置）
MYSQL_DATABASE=management_system
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# AI providers
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
BAILIAN_API_KEY=replace-with-your-bailian-key

# Super admin (唯一最高权限账号，username 与此邮箱一致)
SUPER_ADMIN_EMAIL=your-super-admin@example.com

# QQ SMTP authorization code
QQ_EMAIL_HOST=smtp.qq.com
QQ_EMAIL_PORT=465
QQ_EMAIL_USER=your-qq-number@qq.com
QQ_EMAIL_PASSWORD=replace-with-your-qq-smtp-authorization-code